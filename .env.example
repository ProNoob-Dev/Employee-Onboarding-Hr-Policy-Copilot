# Optional environment variables (never commit a real .env file).
# Unset AZURE_OPENAI_API_KEY -> deterministic local fallback (default).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Unset DATABASE_URL -> in-memory TF-IDF retrieval (default).
DATABASE_URL=
# Required by docker-compose.yml only (api + postgres); set a strong value
# in a gitignored .env file, never here.
POSTGRES_PASSWORD=
LOG_LEVEL=INFO
AUDIT_LOG_PATH=audit.log
